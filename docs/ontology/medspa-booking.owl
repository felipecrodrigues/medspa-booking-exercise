<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#testedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#RepositoryEntity"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#RepositoryEntity"/>
    <rdfs:label>tested by</rdfs:label>
    <rdfs:comment>Links an entity or behavior to tests that provide verification evidence.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#artifactReference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#EvidenceArtifact"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>artifact reference</rdfs:label>
    <rdfs:comment>A repository-relative path or stable external reference to an evidence artifact.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#Owner">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://schema.org/Person"/>
    <rdfs:subClassOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#AccountableParty"/>
    <rdfs:label>Owner</rdfs:label>
    <rdfs:comment>An individual accountable for a repository entity or decision.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#selectionForAppointment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#AppointmentServiceSelection"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#Appointment"/>
    <owl:inverseOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#hasSelection"/>
    <rdfs:label>selection for appointment</rdfs:label>
    <rdfs:comment>Identifies the appointment owning a service-selection association.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#OutputQuality">
    <rdf:type rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#QualityDimension"/>
    <rdfs:label>Output quality</rdfs:label>
    <rdfs:comment>A quality dimension for an agent's produced result, assessed against a documented rubric and independent evidence.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:imports rdf:resource="https://moxie.example.com/ontology/medspa-booking/core"/>
    <rdfs:label>Medspa Booking Domain</rdfs:label>
    <rdfs:comment>Models the medspa, service, and appointment concepts and relationships stated in the take-home exercise, without deciding unspecified booking policies.</rdfs:comment>
    <owl:versionInfo>0.1.0</owl:versionInfo>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-15</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#metricUnavailableReason">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#MetricObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>metric unavailable reason</rdfs:label>
    <rdfs:comment>Explains why an expected metric could not be collected; missing values are never silently imputed.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#bookedDurationMinutes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#AppointmentServiceSelection"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>booked duration in minutes</rdfs:label>
    <rdfs:comment>The service duration captured for this appointment selection at booking time; it remains stable when the catalog duration changes.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#Team">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://schema.org/Organization"/>
    <rdfs:subClassOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#AccountableParty"/>
    <rdfs:label>Team</rdfs:label>
    <rdfs:comment>A group accountable for a repository entity or decision.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#derivedFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label>derived from</rdfs:label>
    <rdfs:comment>Records provenance from a source requirement, specification, decision, or evidence artifact.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#offersService">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#Medspa"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#ServiceOffering"/>
    <owl:inverseOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#offeredBy"/>
    <rdfs:label>offers service</rdfs:label>
    <rdfs:comment>Links a medspa to a service in its catalog. Example: one medspa may offer several services.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#hasSelection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#Appointment"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#AppointmentServiceSelection"/>
    <owl:inverseOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#selectionForAppointment"/>
    <rdfs:label>has service selection</rdfs:label>
    <rdfs:comment>Connects an appointment to an association record for each selected service.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#httpMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#EndpointContract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>HTTP method</rdfs:label>
    <rdfs:comment>The HTTP method explicitly required for an endpoint contract.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#atMedspa">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#Appointment"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#Medspa"/>
    <rdfs:label>at medspa</rdfs:label>
    <rdfs:comment>Identifies the medspa at which an appointment is booked. Example: an appointment is associated with its parent medspa.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#totalDurationMinutes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#Appointment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>total duration in minutes</rdfs:label>
    <rdfs:comment>The appointment duration derived by summing the selected services' booking-time duration snapshots.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#AgentRun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:label>Agent run</rdfs:label>
    <rdfs:comment>One bounded agent execution, including its assigned phase, exact model/variant, input artifacts, outputs, and observable evidence.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#emailAddress">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#Medspa"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>email address</rdfs:label>
    <rdfs:comment>The contact email address recorded for a medspa.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:imports rdf:resource="https://moxie.example.com/ontology/medspa-booking/core"/>
    <rdfs:label>Exercise Requirements and Evaluation</rdfs:label>
    <rdfs:comment>Models source requirements, unresolved decisions, agent runs, quality measurements, and evidence so future exercise outcomes can be evaluated without prescribing an unapproved scoring rubric or metric serialization.</rdfs:comment>
    <owl:versionInfo>0.1.0</owl:versionInfo>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-15</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#endLine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#Symbol"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>end line</rdfs:label>
    <rdfs:comment>Identifies the last source line associated with a code symbol.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#CommitSnapshot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:subClassOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#RepositoryEntity"/>
    <rdfs:label>Commit snapshot</rdfs:label>
    <rdfs:comment>A version-specific state of a logical repository entity, linked to that entity with prov:specializationOf.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#totalPriceInCents">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#Appointment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>total price in cents</rdfs:label>
    <rdfs:comment>The appointment price derived by summing the selected services' booking-time price snapshots.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#questionText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#OpenQuestion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>question text</rdfs:label>
    <rdfs:comment>The unresolved decision stated without implying an answer.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#documentsDecision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#DecisionRecord"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#OpenQuestion"/>
    <rdfs:label>documents decision</rdfs:label>
    <rdfs:comment>Links a decision record to the previously unresolved question it resolves.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#generatedArtifact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#EvidenceArtifact"/>
    <rdfs:label>generated artifact</rdfs:label>
    <rdfs:comment>Links an agent or evaluation activity to an output artifact it produced.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#durationMinutes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#ServiceOffering"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>duration in minutes</rdfs:label>
    <rdfs:comment>The service duration represented as an integer number of minutes, as required by the exercise.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#AppointmentStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Appointment status</rdfs:label>
    <rdfs:comment>The status vocabulary specified by the exercise for an appointment.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#addressesRequirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#EvidenceArtifact"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#Requirement"/>
    <rdfs:label>addresses requirement</rdfs:label>
    <rdfs:comment>Links evidence to the requirement it helps verify.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#observesDimension">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#MetricObservation"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#QualityDimension"/>
    <rdfs:label>observes dimension</rdfs:label>
    <rdfs:comment>Identifies the input or output quality dimension measured by an observation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#Medspa">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://schema.org/LocalBusiness"/>
    <rdfs:label>Medspa</rdfs:label>
    <rdfs:comment>A medical spa business that owns a service catalog and accepts appointments in the exercise domain.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#Repository">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://schema.org/SoftwareSourceCode"/>
    <rdfs:subClassOf rdf:resource="http://usefulinc.com/ns/doap#Project"/>
    <rdfs:subClassOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#RepositoryEntity"/>
    <rdfs:label>Repository</rdfs:label>
    <rdfs:comment>The versioned codebase for this exercise. Give it a stable IRI and use commit snapshots to describe version-specific state.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#metricValueText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#MetricObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>metric value text</rdfs:label>
    <rdfs:comment>A non-numeric observation or explicit unavailable marker when a numeric value cannot be collected.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#aboutAgentRun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#MetricObservation"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#AgentRun"/>
    <rdfs:label>about agent run</rdfs:label>
    <rdfs:comment>Identifies the agent run to which a metric observation applies.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#sourceReference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#Requirement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>source reference</rdfs:label>
    <rdfs:comment>Identifies the source document and section or line from which a requirement was derived.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#runPhase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#AgentRun"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>run phase</rdfs:label>
    <rdfs:comment>The planned or actual phase performed by an agent, such as planning, implementation, review, validation, or evaluation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#definedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#Symbol"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#File"/>
    <owl:inverseOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#defines"/>
    <rdfs:label>defined in</rdfs:label>
    <rdfs:comment>Links a code symbol to the source file containing its definition.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#Test">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#RepositoryEntity"/>
    <rdfs:label>Test</rdfs:label>
    <rdfs:comment>An individual automated test that provides evidence about expected behavior.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#defines">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#File"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#Symbol"/>
    <owl:inverseOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#definedIn"/>
    <rdfs:label>defines</rdfs:label>
    <rdfs:comment>Links a source file to a code symbol whose definition it contains.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#addressText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#Medspa"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>address text</rdfs:label>
    <rdfs:comment>The address text recorded for a medspa; address normalization is not specified by the exercise.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#Class">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#Symbol"/>
    <rdfs:label>Class</rdfs:label>
    <rdfs:comment>A class definition in source code.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#AppointmentServiceSelection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Appointment service selection</rdfs:label>
    <rdfs:comment>The association representing one distinct service selected for one appointment; it stores the service price and duration captured when booked so later catalog edits do not change historical totals.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#path">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#RepositoryEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>repository path</rdfs:label>
    <rdfs:comment>Stores a repository-relative POSIX path for a file or directory.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#metricValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#MetricObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>metric value</rdfs:label>
    <rdfs:comment>An integer input/output quality rating from 1 through 5 when the approved rubric is applied.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#HardRequirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#Requirement"/>
    <rdfs:label>Hard requirement</rdfs:label>
    <rdfs:comment>An explicit requirement that must be met unless a higher-priority user instruction changes it.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#Canceled">
    <rdf:type rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#AppointmentStatus"/>
    <rdfs:label>canceled</rdfs:label>
    <rdfs:comment>The appointment has been canceled.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#ownedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#RepositoryEntity"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#AccountableParty"/>
    <rdfs:label>owned by</rdfs:label>
    <rdfs:comment>Identifies the person or team accountable for a repository entity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#Appointment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Appointment</rdfs:label>
    <rdfs:comment>A future, timezone-aware booking at one medspa that selects one or more distinct services from that medspa and has a status and totals derived from booking-time service snapshots.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#EvaluationFinding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label>Evaluation finding</rdfs:label>
    <rdfs:comment>A finding about requirement coverage, correctness, quality, or risk, linked to the evidence from which it was derived.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#AccountableParty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#RepositoryEntity"/>
    <rdfs:label>Accountable party</rdfs:label>
    <rdfs:comment>A person or team accountable for a repository entity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#decisionState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#OpenQuestion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>decision state</rdfs:label>
    <rdfs:comment>A documented state such as open, decided, or deferred; exact workflow values are project-defined.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#Commit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:subClassOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#RepositoryEntity"/>
    <rdfs:label>Commit</rdfs:label>
    <rdfs:comment>A version-control commit that identifies a repository state.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#httpPath">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#EndpointContract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>HTTP path</rdfs:label>
    <rdfs:comment>The literal route path explicitly required for an endpoint contract.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#metricUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#MetricObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>metric unit</rdfs:label>
    <rdfs:comment>The declared unit or scale for a metric observation, as defined by its metric contract.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#priceInCents">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#ServiceOffering"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>price in cents</rdfs:label>
    <rdfs:comment>The service price represented as an integer number of cents, as required by the exercise.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#offeredBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#ServiceOffering"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#Medspa"/>
    <owl:inverseOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#offersService"/>
    <rdfs:label>offered by</rdfs:label>
    <rdfs:comment>Identifies the medspa that owns a service offering. Example: a service belongs to the medspa whose catalog contains it.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#medspaName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#Medspa"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>medspa name</rdfs:label>
    <rdfs:comment>The business name of a medspa.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#Scheduled">
    <rdf:type rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#AppointmentStatus"/>
    <rdfs:label>scheduled</rdfs:label>
    <rdfs:comment>The appointment is scheduled.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#selects">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#AppointmentServiceSelection"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#ServiceOffering"/>
    <rdfs:label>selects service</rdfs:label>
    <rdfs:comment>Identifies the service represented by an appointment-selection association. Example: an appointment may have separate association records for multiple services.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#Module">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#RepositoryEntity"/>
    <rdfs:label>Module</rdfs:label>
    <rdfs:comment>A logical unit of code organization, such as an application feature or bounded context.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#hasEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#EvidenceArtifact"/>
    <rdfs:label>has evidence</rdfs:label>
    <rdfs:comment>Links an assessment, requirement, metric, or finding to the artifact that supports it.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#commitSha">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#Commit"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>commit SHA</rdfs:label>
    <rdfs:comment>Stores the version-control identifier for a commit.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#ServiceOffering">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://schema.org/Service"/>
    <rdfs:label>Service offering</rdfs:label>
    <rdfs:comment>A treatment or other bookable service offered by one medspa, with a name, description, price in cents, and duration in minutes.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#Requirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label>Requirement</rdfs:label>
    <rdfs:comment>A statement from an authoritative exercise instruction that can be traced to implementation or evaluation evidence.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#findingText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#EvaluationFinding"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>finding text</rdfs:label>
    <rdfs:comment>A concise evidence-grounded evaluation finding.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#version">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#Package"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>version</rdfs:label>
    <rdfs:comment>Stores a package version or a dependency version constraint.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#startTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#Appointment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label>start time</rdfs:label>
    <rdfs:comment>The appointment's start time; approved API inputs include an explicit timezone offset and must be in the future.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#EvaluationRun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:label>Evaluation run</rdfs:label>
    <rdfs:comment>An evaluation activity that applies a documented rubric or metric definition to an agent run or project artifact.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#DecisionRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label>Decision record</rdfs:label>
    <rdfs:comment>A documented decision, its rationale, source, and affected requirements, suitable for recording in OpenSpec.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#hasStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#Appointment"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#AppointmentStatus"/>
    <rdfs:label>has status</rdfs:label>
    <rdfs:comment>Assigns one of the exercise's scheduled, completed, or canceled statuses to an appointment.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#performedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#AgentRun"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#Agent"/>
    <rdfs:label>performed by</rdfs:label>
    <rdfs:comment>Identifies the agent responsible for a particular run.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#agentVariant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#AgentRun"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>agent model variant</rdfs:label>
    <rdfs:comment>The configured model reasoning variant, such as high or max, when one is specified.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#MetricObservation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label>Metric observation</rdfs:label>
    <rdfs:comment>An evidence-linked observation of an agent or artifact metric. Missing values must be marked unavailable rather than fabricated.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>Medspa Booking Exercise Ontology — Core</rdfs:label>
    <rdfs:comment>Reusable vocabulary for identifying the exercise repository and its evidence artifacts; domain and evaluation terms are defined in extension modules.</rdfs:comment>
    <owl:versionInfo>0.1.0</owl:versionInfo>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-15</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#metricName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#MetricDefinition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>metric name</rdfs:label>
    <rdfs:comment>A stable human-readable identifier for a metric or rubric dimension.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#serviceDescription">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#ServiceOffering"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>service description</rdfs:label>
    <rdfs:comment>The description of a service offering.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#Directory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#RepositoryEntity"/>
    <rdfs:label>Directory</rdfs:label>
    <rdfs:comment>A directory in the repository, identified by its repository-relative path.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#EvidenceArtifact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label>Evidence artifact</rdfs:label>
    <rdfs:comment>A test result, review note, command output, source file, or other artifact supporting a requirement assessment or metric.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#File">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#RepositoryEntity"/>
    <rdfs:label>File</rdfs:label>
    <rdfs:comment>A source, test, configuration, specification, or documentation file in the repository.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#modelIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#AgentRun"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>model identifier</rdfs:label>
    <rdfs:comment>The exact provider/model identifier used for an agent run, when observable.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#OpenQuestion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label>Open question</rdfs:label>
    <rdfs:comment>A material ambiguity or unresolved choice that must remain visible until an authorized decision is recorded.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#Method">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#Symbol"/>
    <rdfs:label>Method</rdfs:label>
    <rdfs:comment>A function definition belonging to a class or interface.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#Exercise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label>Exercise</rdfs:label>
    <rdfs:comment>The take-home project being specified, implemented, tested, and evaluated.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#EndpointContract">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#HardRequirement"/>
    <rdfs:label>Endpoint contract</rdfs:label>
    <rdfs:comment>An explicitly listed HTTP method and path whose behavior can be checked against the exercise requirements.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#findingAbout">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#EvaluationFinding"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#Requirement"/>
    <rdfs:label>finding about</rdfs:label>
    <rdfs:comment>Links an evaluation finding to the requirement it concerns.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#Function">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#Symbol"/>
    <rdfs:label>Function</rdfs:label>
    <rdfs:comment>A top-level function definition in source code.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#Completed">
    <rdf:type rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#AppointmentStatus"/>
    <rdfs:label>completed</rdfs:label>
    <rdfs:comment>The appointment has been completed.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#dependsOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#RepositoryEntity"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#RepositoryEntity"/>
    <rdfs:label>depends on</rdfs:label>
    <rdfs:comment>Records a build-time or runtime dependency between repository entities.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#evaluatedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#MetricObservation"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#EvaluationRun"/>
    <rdfs:label>evaluated by</rdfs:label>
    <rdfs:comment>Links a metric observation to the evaluation activity that produced it.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#RepositoryEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Repository entity</rdfs:label>
    <rdfs:comment>A logical entity used to describe the repository, its organization, code, tests, or supporting artifacts.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#bookedPriceInCents">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#AppointmentServiceSelection"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>booked price in cents</rdfs:label>
    <rdfs:comment>The service price captured for this appointment selection at booking time; it remains stable when the catalog price changes.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#appliesTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#Requirement"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#Exercise"/>
    <rdfs:label>applies to</rdfs:label>
    <rdfs:comment>Connects a source requirement to the exercise it governs.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#usesMetricDefinition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#MetricObservation"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#MetricDefinition"/>
    <rdfs:label>uses metric definition</rdfs:label>
    <rdfs:comment>Identifies the versioned rubric or metric contract used to interpret an observation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#containedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#RepositoryEntity"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#RepositoryEntity"/>
    <rdfs:label>contained in</rdfs:label>
    <rdfs:comment>Records direct structural containment, such as a file in a directory or a module in the repository.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#documentedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#RepositoryEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    <rdfs:label>documented by</rdfs:label>
    <rdfs:comment>Links an entity to a specification, decision record, README, or other documentation resource.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#serviceName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#ServiceOffering"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>service name</rdfs:label>
    <rdfs:comment>The display name of a service offering.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#hasInputArtifact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#AgentRun"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#EvidenceArtifact"/>
    <rdfs:label>has input artifact</rdfs:label>
    <rdfs:comment>Links an agent run to the prompt, specification, context, or other input evidence it received.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#requirementStatement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#Requirement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>requirement statement</rdfs:label>
    <rdfs:comment>A concise, traceable statement of the source requirement without adding unstated policy.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#metricVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#MetricDefinition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>metric version</rdfs:label>
    <rdfs:comment>The version of the metric definition or scoring rubric used for reproducibility.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#Package">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#RepositoryEntity"/>
    <rdfs:label>Package</rdfs:label>
    <rdfs:comment>A distributable software unit used by or produced from the repository.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#InputQuality">
    <rdf:type rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#QualityDimension"/>
    <rdfs:label>Input quality</rdfs:label>
    <rdfs:comment>A quality dimension for the clarity, completeness, and relevance of an agent's supplied input.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#startLine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#Symbol"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>start line</rdfs:label>
    <rdfs:comment>Identifies the first source line associated with a code symbol.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#MetricDefinition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Metric definition</rdfs:label>
    <rdfs:comment>A versioned definition of a measurement, including its meaning, method, unit, and applicable rubric.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#QualityDimension">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Quality dimension</rdfs:label>
    <rdfs:comment>A named aspect of agent input or output quality. Its rubric and scale must be documented separately before scoring.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#Dependency">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#RepositoryEntity"/>
    <rdfs:label>Dependency</rdfs:label>
    <rdfs:comment>An external library, runtime, tool, or service on which the repository depends.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#Type">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#Symbol"/>
    <rdfs:label>Type</rdfs:label>
    <rdfs:comment>A type alias, enumeration, structure, or record not better represented by another symbol class.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#Agent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#Owner"/>
    <rdfs:label>AI agent</rdfs:label>
    <rdfs:comment>An AI agent or model instance that contributes to planning, implementation, review, validation, or evaluation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#decisionRationale">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#DecisionRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>decision rationale</rdfs:label>
    <rdfs:comment>Explains why an authorized decision was selected and notes relevant tradeoffs.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#DataModelRequirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#HardRequirement"/>
    <rdfs:label>Data model requirement</rdfs:label>
    <rdfs:comment>A required entity field or relationship stated in the source exercise.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/domain#phoneNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/domain#Medspa"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>phone number</rdfs:label>
    <rdfs:comment>The contact phone number recorded for a medspa.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/evaluation#evaluatesAgentRun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#EvaluationRun"/>
    <rdfs:range rdf:resource="https://moxie.example.com/ontology/medspa-booking/evaluation#AgentRun"/>
    <rdfs:label>evaluates agent run</rdfs:label>
    <rdfs:comment>Identifies the agent execution assessed by an evaluation activity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#TestSuite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#RepositoryEntity"/>
    <rdfs:label>Test suite</rdfs:label>
    <rdfs:comment>A named group of tests, such as a test file or test class.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#Symbol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#RepositoryEntity"/>
    <rdfs:label>Symbol</rdfs:label>
    <rdfs:comment>A named code entity. Prefer one of the specific symbol subclasses when its kind is known.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://moxie.example.com/ontology/medspa-booking/core#Interface">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://moxie.example.com/ontology/medspa-booking/core#Symbol"/>
    <rdfs:label>Interface</rdfs:label>
    <rdfs:comment>An interface, protocol, or trait definition in source code.</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
